# NOTE: the code reads FRONTEND_ORIGIN (singular). Setting FRONTEND_ORIGINS
# (plural) is silently ignored and CORS falls back to "*".
FRONTEND_ORIGIN=https://tecxelens.vercel.app

API_VERSION=v1

# Leave OPENROUTER_API_KEY blank to run without AI prose. Analysis still works;
# finding descriptions and recommendations simply come back empty.
OPENROUTER_API_KEY=

# Comma-separated, tried left to right; the first model that returns usable
# prose wins. The primary is a paid slug because zero-cost ":free" slugs get
# retired without notice and return 429 under load. The free slugs behind it
# are a safety net for when credits run out.
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning,nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free

# Per-request network budgets. Kept tight so a single /analyze stays well
# inside a shared host's request timeout.
AI_TIMEOUT=25
AI_MAX_TOKENS=4000
AI_ENABLE_FALLBACK=true
NVD_TIMEOUT=8
NVD_MAX_KEYWORDS=3

# Optional: raises NVD rate limits.
NVD_API_KEY=

# Link reputation scanning. The provider is pluggable; "virustotal" is the only
# implementation today.
LINK_PROVIDER=virustotal

# From the VirusTotal dashboard. NOTE: the free/Public API is limited to 500
# requests/day and 4/minute, and its terms forbid commercial use. Every URL
# submitted or queried becomes part of the public VirusTotal dataset, so never
# send internal or customer URLs -- is_public_url() blocks private address
# ranges, internal TLDs and INTERNAL_DOMAINS as a safety net.
VIRUSTOTAL_API_KEY=

# Per-request timeout, and how many URLs one scan may cost. The Public API
# allows only 4 requests/minute, so this is capped well below that.
VIRUSTOTAL_TIMEOUT=10
VIRUSTOTAL_MAX_URLS=25

# Set false to look up known URLs only and never request new analyses.
VIRUSTOTAL_SUBMIT=true

# Comma-separated domains that must never be sent to a third party, e.g. your
# own domain and partner portals. Matches the domain and any subdomain.
INTERNAL_DOMAINS=

# Disk budget. PythonAnywhere free caps the whole account at 512 MiB including
# the virtualenv, so uploads and cached analyses are pruned oldest-first.
UPLOAD_MAX_BYTES=26214400
UPLOAD_KEEP_BYTES=125829120
UPLOAD_KEEP_FILES=40
CACHE_KEEP_BYTES=31457280
CACHE_KEEP_FILES=200

# Generated by tools/build_knowledge_index.py — avoids re-parsing the PDF
# corpus at runtime. Defaults to backend/knowledge_index.json.
# KNOWLEDGE_INDEX_PATH=